@page
@model VehiclesModel
@{
    ViewData["Title"] = "Vehicle Management";
    ViewData["ActiveNav"] = "vehicles";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);

    (string cls, string label) ExpiryPill(DateOnly expiry)
    {
        var days = expiry.DayNumber - today.DayNumber;
        if (days < 0) return ("pill-critical", "Expired");
        if (days <= 30) return ("pill-warning", $"{days}d left");
        return ("pill-good", "Valid");
    }
    string StatusPillClass(string status) => status switch
    {
        "Active" => "pill-good", "Maintenance" => "pill-warning", "Idle" => "pill-info", _ => "pill-critical",
    };
    string[] statuses = ["All", "Active", "Maintenance", "Idle", "Out of Service"];
    string[] categories = ["All", "Transit Bus", "Utility Van", "Patrol SUV", "Refuse Truck", "Sedan", "Motorcycle", "Light Truck"];
}

<div class="page-header">
    <div>
        <div class="crumb">@Html.Raw(IconLibrary.Get("vehicle")) Fleet Operations</div>
        <h1>Vehicle Management</h1>
        <div class="page-header__meta">
            <span>@Model.TotalCount vehicles registered</span> · <span>@Model.ActiveCount active</span> · <span style="color:var(--status-warning);">@Model.ExpiringSoonCount docs expiring within 30 days</span>
        </div>
    </div>
    <div class="page-header__actions">
        <a class="btn btn-secondary" href="?handler=Export&Search=@Model.Search&StatusFilter=@Model.StatusFilter&CategoryFilter=@Model.CategoryFilter">@Html.Raw(IconLibrary.Get("download")) Export</a>
        <button class="btn btn-primary" data-drawer-open="drawer-add-vehicle">@Html.Raw(IconLibrary.Get("plus")) Register vehicle</button>
    </div>
</div>

<div class="grid grid-12" style="margin-bottom:18px;">
    <div class="card stat-tile col-3">
        <div class="stat-tile__top"><span class="stat-tile__label">Total fleet</span><div class="stat-tile__icon">@Html.Raw(IconLibrary.Get("vehicle"))</div></div>
        <div class="stat-tile__value tabular">@Model.TotalCount</div>
    </div>
    <div class="card stat-tile col-3">
        <div class="stat-tile__top"><span class="stat-tile__label">Active</span><div class="stat-tile__icon">@Html.Raw(IconLibrary.Get("zap"))</div></div>
        <div class="stat-tile__value tabular">@Model.ActiveCount</div>
    </div>
    <div class="card stat-tile col-3">
        <div class="stat-tile__top"><span class="stat-tile__label">In maintenance</span><div class="stat-tile__icon" style="background:var(--status-warning-tint); color:var(--status-warning);">@Html.Raw(IconLibrary.Get("wrench"))</div></div>
        <div class="stat-tile__value tabular">@Model.MaintenanceCount</div>
    </div>
    <div class="card stat-tile col-3">
        <div class="stat-tile__top"><span class="stat-tile__label">Docs expiring soon</span><div class="stat-tile__icon" style="background:var(--status-critical-tint); color:var(--status-critical);">@Html.Raw(IconLibrary.Get("file-text"))</div></div>
        <div class="stat-tile__value tabular">@Model.ExpiringSoonCount</div>
    </div>
</div>

<div class="card card-pad">
    <form method="get" class="toolbar">
        <label class="search-field" style="width:280px;">
            @Html.Raw(IconLibrary.Get("search"))
            <input type="text" name="Search" value="@Model.Search" placeholder="Search plate, make, model, VIN…" />
        </label>
        @foreach (var s in statuses)
        {
            var isActive = (Model.StatusFilter ?? "All") == s;
            <a class="chip @(isActive ? "active" : "")" href="?Search=@Model.Search&StatusFilter=@s&CategoryFilter=@Model.CategoryFilter">@s</a>
        }
        <div class="toolbar-spacer"></div>
        <select class="select" name="CategoryFilter" style="width:170px;" onchange="this.form.submit()">
            @foreach (var c in categories)
            {
                <option value="@c" selected="@(c == (Model.CategoryFilter ?? "All"))">@(c == "All" ? "All categories" : c)</option>
            }
        </select>
        <button type="submit" class="btn btn-secondary filter-btn">@Html.Raw(IconLibrary.Get("filter")) Apply</button>
    </form>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Vehicle</th><th>Category</th><th>Status</th><th>Driver</th><th>Health</th>
                    <th class="num">Odometer</th><th>Insurance</th><th>Next service</th><th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Vehicles.Count == 0)
                {
                    <tr><td colspan="9"><div class="empty-state">@Html.Raw(IconLibrary.Get("vehicle"))<strong>No vehicles match these filters</strong><span>Try clearing search or filters.</span></div></td></tr>
                }
                @foreach (var v in Model.Vehicles)
                {
                    var (ic, il) = ExpiryPill(v.InsuranceExpiry);
                    <tr>
                        <td>
                            <div class="row-flag">
                                <div class="row-flag__icon">@Html.Raw(IconLibrary.Get("vehicle"))</div>
                                <div class="row-flag__meta">
                                    <span class="row-primary mono">@v.PlateNumber</span>
                                    <span>@v.Make @v.Model · @v.Year</span>
                                </div>
                            </div>
                        </td>
                        <td>@v.Category</td>
                        <td><span class="pill @StatusPillClass(v.Status)"><span class="dot"></span>@v.Status</span></td>
                        <td>@(v.AssignedDriver?.Name ?? "—")</td>
                        <td>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <div class="meter @(v.HealthScore < 60 ? "critical" : v.HealthScore < 80 ? "warning" : "")" style="width:56px;"><div class="meter__fill" style="width:@(v.HealthScore)%;"></div></div>
                                <span class="mono" style="font-size:12px;">@v.HealthScore</span>
                            </div>
                        </td>
                        <td class="num mono">@v.OdometerKm.ToString("N0") km</td>
                        <td><span class="pill @ic">@il</span></td>
                        <td class="mono" style="font-size:12.5px;">@v.NextServiceDue.ToString("MMM d, yyyy")</td>
                        <td>
                            <div class="row-actions">
                                <button class="icon-btn btn-icon-only" data-drawer-open="drawer-@v.Id" title="View / edit">@Html.Raw(IconLibrary.Get("edit"))</button>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@v.Id" onsubmit="return confirm('Remove @v.PlateNumber from the fleet? This also removes its trip, fuel and maintenance history.');" style="display:inline;">
                                    <button type="submit" class="icon-btn btn-icon-only" title="Delete">@Html.Raw(IconLibrary.Get("trash"))</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="pagination">
        <span>Showing <strong class="text-secondary">1–@Model.Vehicles.Count</strong> of <strong class="text-secondary">@Model.TotalCount</strong> vehicles</span>
        <div class="pagination-controls">
            <button class="page-btn">@Html.Raw(IconLibrary.Get("chevron-left"))</button>
            <button class="page-btn active">1</button>
            <button class="page-btn">@Html.Raw(IconLibrary.Get("chevron-right"))</button>
        </div>
    </div>
</div>

<div class="drawer-overlay" data-drawer-overlay></div>

@foreach (var v in Model.Vehicles)
{
    var (ic, il) = ExpiryPill(v.InsuranceExpiry);
    var (rc, rl) = ExpiryPill(v.RegistrationExpiry);
    var tabsId = "tabs-" + v.Id;
    <div class="drawer" id="drawer-@v.Id">
        <div class="drawer-head">
            <div>
                <div style="font-size:11px; font-weight:700; letter-spacing:.04em; color:var(--ink-3); text-transform:uppercase;">Vehicle profile</div>
                <div style="font-size:18px; font-weight:800; font-family:var(--font-mono);">@v.PlateNumber</div>
            </div>
            <button class="icon-btn" data-drawer-close aria-label="Close">@Html.Raw(IconLibrary.Get("x"))</button>
        </div>
        <form method="post" asp-page-handler="Edit" asp-route-id="@v.Id" class="drawer-body" style="overflow-y:auto;">
            <input type="hidden" name="Search" value="@Model.Search" /><input type="hidden" name="StatusFilter" value="@Model.StatusFilter" /><input type="hidden" name="CategoryFilter" value="@Model.CategoryFilter" />
            <div style="display:flex; align-items:center; gap:14px; margin-bottom:18px;">
                <div class="stat-tile__icon" style="width:52px; height:52px; border-radius:14px;">@Html.Raw(IconLibrary.Get("vehicle"))</div>
                <div>
                    <div style="font-weight:700; font-size:15px;">@v.Make @v.Model</div>
                    <div class="text-muted" style="font-size:12.5px;">VIN @v.Vin</div>
                </div>
                <span class="pill @StatusPillClass(v.Status)" style="margin-left:auto;"><span class="dot"></span>@v.Status</span>
            </div>

            <div class="tabs" data-tabs="@tabsId">
                <button type="button" class="tab-btn active" data-tab="overview">Overview</button>
                <button type="button" class="tab-btn" data-tab="documents">Documents</button>
                <button type="button" class="tab-btn" data-tab="service">Service history</button>
            </div>

            <div data-tab-panel-group="@tabsId" data-tab-panel="overview" class="tab-panel active">
                <div class="form-row">
                    <div class="field"><label>Make</label><input class="input" name="make" value="@v.Make" required /></div>
                    <div class="field"><label>Model</label><input class="input" name="model" value="@v.Model" required /></div>
                </div>
                <div class="form-row">
                    <div class="field"><label>Year</label><input class="input" type="number" name="year" value="@v.Year" required /></div>
                    <div class="field"><label>Category</label>
                        <select class="select" name="category">
                            @foreach (var c in new[] { "Transit Bus", "Utility Van", "Patrol SUV", "Refuse Truck", "Sedan", "Motorcycle", "Light Truck" })
                            {
                                <option selected="@(c == v.Category)">@c</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="field"><label>Fuel type</label>
                        <select class="select" name="fuelType">
                            @foreach (var f in new[] { "Diesel", "Petrol", "Electric", "Hybrid", "CNG" })
                            {
                                <option selected="@(f == v.FuelType)">@f</option>
                            }
                        </select>
                    </div>
                    <div class="field"><label>Status</label>
                        <select class="select" name="status">
                            @foreach (var s in new[] { "Active", "Maintenance", "Idle", "Out of Service" })
                            {
                                <option selected="@(s == v.Status)">@s</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="field"><label>Depot</label>
                        <select class="select" name="depot">
                            @foreach (var d in new[] { "Central Garage", "North Depot", "Riverside Yard", "Harbor Terminal" })
                            {
                                <option selected="@(d == v.Depot)">@d</option>
                            }
                        </select>
                    </div>
                    <div class="field"><label>Assigned driver</label>
                        <select class="select" name="assignedDriverId">
                            <option value="">Unassigned</option>
                            @foreach (var d in Model.AllDrivers)
                            {
                                <option value="@d.Id" selected="@(d.Id == v.AssignedDriverId)">@d.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="field"><label>Odometer (km)</label><input class="input mono" type="number" name="odometerKm" value="@v.OdometerKm" /></div>
                    <div class="field"><label>Health score</label><input class="input mono" type="number" min="0" max="100" name="healthScore" value="@v.HealthScore" /></div>
                </div>
            </div>

            <div data-tab-panel-group="@tabsId" data-tab-panel="documents" class="tab-panel">
                <div class="form-row">
                    <div class="field"><label>Registration expiry</label><input class="input" type="date" name="registrationExpiry" value="@v.RegistrationExpiry.ToString("yyyy-MM-dd")" /><span class="pill @rc" style="margin-top:4px; width:fit-content;">@rl</span></div>
                    <div class="field"><label>Insurance expiry</label><input class="input" type="date" name="insuranceExpiry" value="@v.InsuranceExpiry.ToString("yyyy-MM-dd")" /><span class="pill @ic" style="margin-top:4px; width:fit-content;">@il</span></div>
                </div>
                <div class="field"><label>Next service due</label><input class="input" type="date" name="nextServiceDue" value="@v.NextServiceDue.ToString("yyyy-MM-dd")" /></div>
                <div class="doc-row" style="margin-top:14px;">
                    <div class="doc-row__icon">@Html.Raw(IconLibrary.Get("check-circle"))</div>
                    <div style="flex:1;">
                        <div style="font-size:13px; font-weight:650;">Last inspection certificate</div>
                        <div class="text-muted" style="font-size:11.5px;">Issued @v.LastServiceDate.ToString("MMM d, yyyy")</div>
                    </div>
                    <span class="pill pill-good">On file</span>
                </div>
            </div>

            <div data-tab-panel-group="@tabsId" data-tab-panel="service" class="tab-panel">
                @{ var history = Model.MaintenanceByVehicle.GetValueOrDefault(v.Id, []); }
                @if (history.Count == 0)
                {
                    <div class="empty-state">
                        @Html.Raw(IconLibrary.Get("wrench"))
                        <strong>No service history yet</strong>
                        <span>Maintenance records will appear here once logged.</span>
                    </div>
                }
                else
                {
                    <div class="timeline">
                        @foreach (var m in history)
                        {
                            <div class="timeline-item">
                                <div class="timeline-item__icon" style="background:var(--brand-50); color:var(--brand-600);">@Html.Raw(IconLibrary.Get("wrench"))</div>
                                <div class="timeline-item__body">
                                    <p style="font-weight:600;">@m.ServiceType</p>
                                    <time>@m.Date.ToString("MMM d, yyyy") · @m.Workshop · $@m.Cost.ToString("N0")</time>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:18px;">@Html.Raw(IconLibrary.Get("check-circle")) Save changes</button>
        </form>
    </div>
}

<div class="drawer" id="drawer-add-vehicle">
    <div class="drawer-head">
        <div style="font-size:16px; font-weight:800;">Register vehicle</div>
        <button class="icon-btn" data-drawer-close aria-label="Close">@Html.Raw(IconLibrary.Get("x"))</button>
    </div>
    <div class="drawer-body">
        <form class="auth-form" method="post" asp-page-handler="Add">
            <div class="form-row">
                <div class="field"><label>Plate number</label><input class="input mono" name="plateNumber" placeholder="MMTA-2345" required /></div>
                <div class="field"><label>Category</label>
                    <select class="select" name="category">
                        <option>Transit Bus</option><option>Utility Van</option><option>Patrol SUV</option>
                        <option>Refuse Truck</option><option>Sedan</option><option>Motorcycle</option><option>Light Truck</option>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="field"><label>Make</label><input class="input" name="make" placeholder="Volvo" required /></div>
                <div class="field"><label>Model</label><input class="input" name="model" placeholder="7900 Electric" required /></div>
            </div>
            <div class="form-row">
                <div class="field"><label>Year</label><input class="input" name="year" type="number" value="2026" required /></div>
                <div class="field"><label>Fuel type</label>
                    <select class="select" name="fuelType"><option>Diesel</option><option>Petrol</option><option>Electric</option><option>Hybrid</option><option>CNG</option></select>
                </div>
            </div>
            <div class="field"><label>VIN</label><input class="input mono" name="vin" placeholder="Vehicle identification number" required /></div>
            <div class="form-row">
                <div class="field"><label>Depot</label>
                    <select class="select" name="depot"><option>Central Garage</option><option>North Depot</option><option>Riverside Yard</option><option>Harbor Terminal</option></select>
                </div>
                <div class="field"><label>GPS device ID</label><input class="input mono" name="gpsDeviceId" placeholder="GPS-XXXX" required /></div>
            </div>
            <div class="form-row">
                <div class="field"><label>Registration expiry</label><input class="input" type="date" name="registrationExpiry" required /></div>
                <div class="field"><label>Insurance expiry</label><input class="input" type="date" name="insuranceExpiry" required /></div>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-lg">@Html.Raw(IconLibrary.Get("check-circle")) Save vehicle</button>
        </form>
    </div>
</div>
