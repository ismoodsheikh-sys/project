@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<a href="/Login" class="back-link">@Html.Raw(IconLibrary.Get("chevron-left")) Back to sign in</a>

<div class="auth-card__head">
    <h1>Reset your password</h1>
    <p>Enter the work email on your account and we'll send a secure reset link to confirm it's you.</p>
</div>

<form class="auth-form" method="post">
    <div class="field">
        <label for="email">Work email</label>
        <div class="input-icon-wrap">
            @Html.Raw(IconLibrary.Get("mail"))
            <input class="input" type="email" id="email" name="Email" placeholder="you@agency.gov" required autofocus />
        </div>
        <span class="hint">A reset link will be sent to this address, valid for 10 minutes.</span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block">
        Send reset link
        @Html.Raw(IconLibrary.Get("arrow-up-right"))
    </button>
</form>

<p class="auth-foot-link">Remembered it after all? <a href="/Login">Sign in instead</a></p>
