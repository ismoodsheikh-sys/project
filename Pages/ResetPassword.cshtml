@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_AuthLayout";
    var token = Request.Query["token"].ToString();
}

<a href="/Login" class="back-link">@Html.Raw(IconLibrary.Get("chevron-left")) Back to sign in</a>

@if (!Model.LinkValid)
{
    <div class="auth-card__head">
        <h1>Link expired</h1>
        <p>This password reset link is invalid or has expired. Request a new one to continue.</p>
    </div>
    <a href="/ForgotPassword" class="btn btn-primary btn-lg btn-block">@Html.Raw(IconLibrary.Get("arrow-up-right")) Request a new link</a>
}
else
{
    <div class="auth-card__head">
        <h1>Set a new password</h1>
        <p>Choose a strong password you haven't used before on this account.</p>
    </div>
    @if (Model.Error != null)
    {
        <div class="pill pill-critical" style="margin-bottom:16px; padding:8px 12px;">
            @Html.Raw(IconLibrary.Get("alert-triangle")) @Model.Error
        </div>
    }
    <form class="auth-form" method="post">
        <input type="hidden" name="token" value="@token" />
        <div class="field">
            <label for="pw1">New password</label>
            <div class="input-icon-wrap">
                @Html.Raw(IconLibrary.Get("lock"))
                <input class="input" type="password" id="pw1" name="NewPassword" placeholder="At least 8 characters" required minlength="8" />
                <button type="button" class="toggle-visibility" data-toggle-visibility="pw1" aria-label="Show password">@Html.Raw(IconLibrary.Get("eye"))</button>
            </div>
        </div>
        <div class="field">
            <label for="pw2">Confirm new password</label>
            <div class="input-icon-wrap">
                @Html.Raw(IconLibrary.Get("lock"))
                <input class="input" type="password" id="pw2" name="ConfirmPassword" placeholder="Re-enter password" required minlength="8" />
                <button type="button" class="toggle-visibility" data-toggle-visibility="pw2" aria-label="Show password">@Html.Raw(IconLibrary.Get("eye"))</button>
            </div>
        </div>
        <button type="submit" class="btn btn-primary btn-lg btn-block">@Html.Raw(IconLibrary.Get("check-circle")) Update password</button>
    </form>
}
